{
    "name": "silavisions/zatca",
    "description": "ZATCA (Fatoora) Phase-2 e-invoicing for PHP — UBL 2.1 generation, XAdES signing, QR, CSID onboarding and submission. Derived from saleh7/php-zatca-xml.",
    "keywords": [
        "ZATCA",
        "fatoora",
        "e-invoice",
        "invoice",
        "ubl",
        "ubl invoice",
        "qr-code",
        "xml",
        "saudi",
        "einvoicing"
    ],
    "homepage": "https://github.com/silavisions/zatca",
    "license": "MIT",
    "authors": [
        {
            "name": "Sila Visions",
            "email": "silavisions@gmail.com"
        },
        {
            "name": "Saleh7",
            "email": "Saleh7@protonmail.ch",
            "homepage": "https://github.com/Saleh7",
            "role": "Original author of saleh7/php-zatca-xml"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-openssl": "*",
        "ext-hash": "*",
        "sabre/xml": "^4.0",
        "guzzlehttp/guzzle": "^7.9",
        "phpseclib/phpseclib": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Saleh7\\Zatca\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Saleh7\\Zatca\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "support": {
        "source": "https://github.com/silavisions/zatca",
        "issues": "https://github.com/silavisions/zatca/issues"
    }
}
